# Port the Express server listens on
PORT=3000

# ---------------------------------------------------------------------------
# Database (server/services/db/) -- audit history persistence
# ---------------------------------------------------------------------------
# Which backend implementation to use. Only "sqlite" is implemented in this
# MVP; see server/services/db/index.js for how to plug in another one later.
# DB_DRIVER=sqlite

# Optional -- override where the SQLite file lives. Defaults to
# <project root>/data/sitefix.db (created automatically on first run).
# SQLITE_DB_PATH=./data/sitefix.db

# ---------------------------------------------------------------------------
# AI analysis (server/services/aiAnalyzer.js)
# ---------------------------------------------------------------------------
# Required for POST /api/audit/analyze. Get a key from https://console.anthropic.com/
# NEVER commit your real key or expose it to frontend code -- it is only
# ever read server-side via process.env.
ANTHROPIC_API_KEY=

# Optional -- override the Claude model used for recommendations.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional -- override the max output tokens for the AI's response.
# ANTHROPIC_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Admin API key lookup (server/services/admin/, GET /api/admin/key-status)
# ---------------------------------------------------------------------------
# Optional feature -- only required if you want the /api/admin/key-status
# diagnostic endpoint to work. Both values are required together.
#
# ANTHROPIC_ADMIN_KEY is a distinct credential from ANTHROPIC_API_KEY above:
# an Admin API key (starts with sk-ant-admin...), created at
# https://console.anthropic.com/settings/admin-keys. It can read/manage
# organization resources (API keys, workspaces, members) -- treat it with
# at least as much care as ANTHROPIC_API_KEY, and NEVER expose it to
# frontend code.
# ANTHROPIC_ADMIN_KEY=

# The apikey_... ID (not the key value itself) of the API key you want the
# diagnostic to report on -- typically the same key used for
# ANTHROPIC_API_KEY above. Find it at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY_ID=
